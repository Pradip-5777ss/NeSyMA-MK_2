    "text": "def calculate_factorial(n):\n    if n < 0:\n        return None\n    result = 1\n    i = 1\n    while i <= n:\n        result = result * i\n        i += 1\n    return result\n\nif __name__ == \"__main__\":\n    fact = calculate_factorial(5)\n    print(\"Factorial of 5:\", fact)\n",
